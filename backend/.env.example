# Dexar LMS Backend Configuration Template
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit your real .env file to Git!

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dexar_lms?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_random_string_here

# Frontend Application URL (Used for CORS and reset email links)
FRONTEND_URL=https://dexartechnologies.in

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Gmail SMTP Email Dispatcher Credentials (for Password Resets & Notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Dexar Technologies"
