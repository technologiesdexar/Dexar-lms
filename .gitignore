# Root .gitignore for Dexar LMS Platform

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Node Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary directories
tmp/
temp/
